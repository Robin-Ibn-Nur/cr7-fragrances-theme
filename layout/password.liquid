<!doctype html>
<html
  class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}"
  lang="{{ request.locale.iso_code }}"
  dir="{{ request.locale.direction | default: 'ltr' }}"
>
  <head>
    {%- render 'stylesheets' -%}

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {%- render 'view-transition-opt-in' -%}

    {%- render 'meta-tags' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-palette' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
  </head>

  <body class="page-width-{{ settings.page_width }}">
    <main
      id="MainContent"
      class="content-for-layout password-main-content"
      role="main"
    >
      {{ content_for_layout }}
    </main>

    <footer>
      {% section 'password-footer' %}
    </footer>

    {%- form 'storefront_password' -%}
      <dialog-component id="password-form">
        <dialog
          ref="dialog"
          class="password-dialog"
          {% if form.errors %}
            open
          {% endif %}
          aria-labelledby="password-dialog-heading"
        >
          <div class="password-dialog__header">
            <button
              class="button-unstyled close-button password-dialog__close-button"
              on:click="dialog-component/closeDialog"
              type="button"
            >
              <span
                class="svg-wrapper svg-wrapper--small"
                title="{{ 'actions.close' | t }}"
              >
                {{ 'icon-close.svg' | inline_asset_content }}
              </span>
            </button>
          </div>
          <div class="password-dialog__content">
            <h2
              id="password-dialog-heading"
              class="password-dialog__title h3"
            >
              {{ 'actions.enter_password' | t }}
            </h2>

            <div class="email-signup__input-group">
              <label
                for="Password"
                class="visually-hidden"
              >
                {{ 'placeholders.password' | t }}
              </label>

              <input
                type="password"
                name="password"
                id="Password"
                class="field__input field__input--button-radius field__input--button-padding"
                autocomplete="current-password"
                {% if form.errors %}
                  aria-invalid="true"
                  aria-describedby="PasswordLoginForm-password-error"
                {%- endif -%}
                placeholder="{{ 'placeholders.password' | t }}"
                autofocus
              >

              <button
                class="button password-dialog__submit-button"
                type="submit"
              >
                {{ 'actions.submit' | t }}
              </button>
            </div>

            {%- if form.errors -%}
              <div
                id="PasswordLoginForm-password-error"
                class="email-signup__message"
                tabindex="-1"
              >
                <svg
                  viewBox="0 0 20 20"
                  xmlns="http://www.w3.org/2000/svg"
                  focusable="false"
                  aria-hidden="true"
                  class="icon-error"
                >
                  {%- render 'icon', icon: 'error'  -%}
                </svg>
                {{ 'content.wrong_password' | t }}
              </div>
            {%- endif -%}

            {%- if settings.show_demo_password and settings.demo_password != blank -%}
              <style>
                .cr7-demo-pw-box {
                  display: flex;
                  flex-wrap: wrap;
                  align-items: center;
                  justify-content: center;
                  gap: 8px 10px;
                  margin-top: 14px;
                  padding: 10px 14px;
                  border: 1px solid rgba(10, 10, 10, 0.14);
                  border-radius: 6px;
                  background: #f8f9fa;
                  font-size: 13px;
                  color: #0a0a0a;
                }
                .cr7-demo-pw-box__label {
                  color: #55595e;
                }
                .cr7-demo-pw-box__code {
                  padding: 2px 8px;
                  border-radius: 4px;
                  background: #ffffff;
                  border: 1px solid rgba(10, 10, 10, 0.12);
                  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
                  font-weight: 600;
                  letter-spacing: 0.04em;
                }
                .cr7-demo-pw-box__btn {
                  padding: 4px 10px;
                  border: 1px solid #008a38;
                  border-radius: 4px;
                  background: transparent;
                  color: #008a38;
                  font-size: 12px;
                  font-weight: 600;
                  cursor: pointer;
                }
                .cr7-demo-pw-box__btn:hover {
                  background: #008a38;
                  color: #ffffff;
                }
              </style>
              <div class="cr7-demo-pw-box" data-cr7-demo-pw>
                <span class="cr7-demo-pw-box__label">{{ settings.demo_password_label | default: 'Storefront Password' | escape }}:</span>
                <code class="cr7-demo-pw-box__code">{{ settings.demo_password | escape }}</code>
                <button
                  type="button"
                  class="cr7-demo-pw-box__btn"
                  data-copy-pw="{{ settings.demo_password | escape }}"
                >
                  Copy &amp; Fill
                </button>
              </div>
              <script>
                (function () {
                  var btn = document.querySelector('[data-cr7-demo-pw] [data-copy-pw]');
                  if (!btn || btn.__bound) return;
                  btn.__bound = true;
                  btn.addEventListener('click', function () {
                    var pw = btn.getAttribute('data-copy-pw') || '';
                    var input = document.getElementById('Password');
                    if (input) input.value = pw;
                    if (navigator.clipboard && navigator.clipboard.writeText) {
                      navigator.clipboard.writeText(pw).catch(function () {});
                    }
                    btn.textContent = 'Copied & Filled';
                    window.setTimeout(function () { btn.textContent = 'Copy & Fill'; }, 1800);
                  });
                })();
              </script>
            {%- endif -%}
          </div>
        </dialog>
      </dialog-component>
    {%- endform -%}

    {%- render 'password-layout-styles' -%}
  </body>
</html>
