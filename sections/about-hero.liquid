{%- comment -%}
  About Hero Section
  Black-and-white editorial hero: serif headline + copy left, portrait right.
{%- endcomment -%}

{{ 'about.css' | asset_url | stylesheet_tag }}
<script src="{{ 'about.js' | asset_url }}" defer></script>

{%- liquid
  assign link_href = section.settings.link_url | default: routes.collections_url
  assign portrait = section.settings.image
  assign portrait_alt = portrait.alt | default: '' | escape
-%}

<section
  id="About-Hero-{{ section.id }}"
  class="about-section about-hero"
  data-about-section
  data-section-id="{{ section.id }}"
  style="
    --about-bg: {{ section.settings.background_color }};
    --about-text: {{ section.settings.text_color }};
    --about-muted: {{ section.settings.muted_color }};
    --about-hairline: {{ section.settings.hairline_color }};
    --about-panel: {{ section.settings.panel_color }};
  "
>
  <div class="about-container">
    <div class="about-hero__grid">
      <div class="about-hero__content about-reveal">
        {%- if section.settings.eyebrow != blank -%}
          <div class="about-eyebrow-row">
            <span class="about-eyebrow">{{ section.settings.eyebrow | escape }}</span>
            <span class="about-hairline" aria-hidden="true"></span>
          </div>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h1 class="about-heading about-hero__heading">
            {{- section.settings.heading | escape | newline_to_br -}}
          </h1>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <p class="about-paragraph about-hero__desc">
            {{- section.settings.text | escape -}}
          </p>
        {%- endif -%}

        {%- if section.settings.link_label != blank -%}
          <a href="{{ link_href }}" class="about-link">
            <span>{{ section.settings.link_label | escape }}</span>
            {% render 'about-icon', icon: 'arrow-right', class: 'about-link__arrow' %}
          </a>
        {%- endif -%}
      </div>

      <div class="about-hero__media about-reveal">
        {%- assign img_classes = 'about-hero__img' -%}
        {%- if section.settings.blend_image -%}
          {%- assign img_classes = img_classes | append: ' about-hero__img--blend' -%}
        {%- endif -%}
        {%- if portrait != blank -%}
          <div
            class="about-hero__img-wrap"
            style="aspect-ratio: {{ portrait.aspect_ratio | default: 0.8 }};"
          >
            {{ portrait | image_url: width: 2400 | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              class: img_classes,
              alt: portrait_alt,
              widths: '800, 1200, 1600, 2000, 2400',
              sizes: '(min-width: 750px) 45vw, 100vw'
            }}
          </div>
        {%- else -%}
          <div class="about-hero__img-wrap">
            <img
              src="{{ 'about-hero-portrait.jpg' | asset_url }}"
              alt="Cristiano Ronaldo"
              class="{{ img_classes }}"
              loading="eager"
              fetchpriority="high"
              width="1200"
              height="1000"
            >
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Hero",
  "tag": "section",
  "class": "section-about-hero",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#55595e"
    },
    {
      "type": "color",
      "id": "hairline_color",
      "label": "Hairline",
      "default": "#cfcfcf"
    },
    {
      "type": "color",
      "id": "panel_color",
      "label": "Placeholder panel",
      "default": "#f5f5f5"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "ABOUT CR7 FRAGRANCES"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "More Than\na Fragrance."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Paragraph",
      "default": "CR7 Fragrances is a celebration of confidence, ambition and the winning mindset. Inspired by Cristiano Ronaldo, it's more than a fragrance — it's a lifestyle."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "OUR COLLECTION"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "header",
      "content": "Portrait Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Portrait image"
    },
    {
      "type": "checkbox",
      "id": "blend_image",
      "label": "Blend image into background",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "About Hero"
    }
  ]
}
{% endschema %}

