{%- comment -%}
  About Values Section
  Centered eyebrow with hairlines on both sides, serif heading, and divided value columns.
{%- endcomment -%}

{{ 'about.css' | asset_url | stylesheet_tag }}

<section
  id="About-Values-{{ section.id }}"
  class="about-section about-values"
  data-about-section
  data-section-id="{{ section.id }}"
  style="
    --about-bg: {{ section.settings.background_color }};
    --about-text: {{ section.settings.text_color }};
    --about-muted: {{ section.settings.muted_color }};
    --about-hairline: {{ section.settings.hairline_color }};
    --about-values-cols: {{ section.blocks.size | at_least: 1 | at_most: 5 }};
  "
>
  <div class="about-container">
    <div class="about-values__header about-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <div class="about-values__eyebrow-row">
          <span class="about-values__hairline" aria-hidden="true"></span>
          <span class="about-values__eyebrow">{{ section.settings.eyebrow | escape }}</span>
          <span class="about-values__hairline" aria-hidden="true"></span>
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="about-heading about-values__heading">
          {{- section.settings.heading | escape -}}
        </h2>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="about-values__grid">
        {%- for block in section.blocks -%}
          {%- assign custom_icon = block.settings.custom_icon -%}
          <div class="about-value about-reveal" {{ block.shopify_attributes }}>
            <div class="about-value__icon" aria-hidden="true">
              {%- if block.settings.icon == 'custom' and custom_icon != blank -%}
                {{ custom_icon | image_url: width: 144 | image_tag:
                  loading: 'lazy',
                  alt: '',
                  width: 36,
                  height: 36
                }}
              {%- elsif block.settings.icon != 'custom' -%}
                {% render 'about-icon', icon: block.settings.icon %}
              {%- endif -%}
            </div>

            {%- if block.settings.name != blank -%}
              <h3 class="about-value__title">{{ block.settings.name | escape }}</h3>
            {%- endif -%}

            {%- if block.settings.tagline != blank -%}
              <p class="about-value__tagline">{{ block.settings.tagline | escape }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "About Values",
  "tag": "section",
  "class": "section-about-values",
  "max_blocks": 5,
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#55595e"
    },
    {
      "type": "color",
      "id": "hairline_color",
      "label": "Hairline",
      "default": "#cfcfcf"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "OUR VALUES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Drives Us"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "trophy", "label": "Trophy" },
            { "value": "diamond", "label": "Diamond" },
            { "value": "star", "label": "Star" },
            { "value": "infinity", "label": "Infinity" },
            { "value": "shield", "label": "Shield" },
            { "value": "heart", "label": "Heart" },
            { "value": "flame", "label": "Flame" },
            { "value": "crown", "label": "Crown" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "target", "label": "Target" },
            { "value": "custom", "label": "Custom image" }
          ],
          "default": "trophy"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom icon image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Value name",
          "default": "Confidence"
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "Tagline",
          "default": "Believe in yourself."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Values",
      "blocks": [
        {
          "type": "value",
          "settings": { "icon": "trophy", "name": "Confidence", "tagline": "Believe in yourself." }
        },
        {
          "type": "value",
          "settings": { "icon": "diamond", "name": "Elegance", "tagline": "Stand out effortlessly." }
        },
        {
          "type": "value",
          "settings": { "icon": "star", "name": "Ambition", "tagline": "Aim higher." }
        },
        {
          "type": "value",
          "settings": { "icon": "infinity", "name": "Legacy", "tagline": "Leave a mark." }
        }
      ]
    }
  ]
}
{% endschema %}

