{%- comment -%}
  CR7 Bento Showcase Section
  Asymmetric dark editorial Bento Grid for the 4 signature fragrance stories.
{%- endcomment -%}

{{ 'cr7-bento-showcase.css' | asset_url | stylesheet_tag }}

<section
  id="CR7-Bento-{{ section.id }}"
  class="cr7-bento"
  data-section-id="{{ section.id }}"
>
  <div class="cr7-bento__container">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <header class="cr7-bento__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="cr7-bento__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="cr7-bento__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="cr7-bento__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="cr7-bento__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_index = forloop.index
          assign card_href = block.settings.link | default: routes.all_products_collection_url
          assign card_img = block.settings.image
          assign card_alt = block.settings.title | default: 'CR7 Fragrance' | escape
        -%}
        <a
          href="{{ card_href }}"
          class="cr7-bento__card cr7-bento__card--{{ card_index }}"
          {{ block.shopify_attributes }}
        >
          <div class="cr7-bento__top">
            {%- if block.settings.pill != blank -%}
              <span class="cr7-bento__pill">{{ block.settings.pill | escape }}</span>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="cr7-bento__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.subtitle != blank -%}
              <p class="cr7-bento__desc">{{ block.settings.subtitle | escape }}</p>
            {%- endif -%}
          </div>

          <div class="cr7-bento__frame">
            {%- if card_img != blank -%}
              {{ card_img | image_url: width: 1400 | image_tag:
                loading: 'lazy',
                class: 'cr7-bento__img',
                alt: card_alt,
                widths: '500, 800, 1100, 1400',
                sizes: '(min-width: 990px) 45vw, 95vw'
              }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'cr7-bento__img' }}
            {%- endif -%}

            <span class="cr7-bento__cta" aria-hidden="true">
              <span>Explore</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CR7 Bento Showcase",
  "tag": "section",
  "class": "section-cr7-bento",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE FRAGRANCE UNIVERSE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Four expressions of greatness."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Each scent is crafted for a distinct chapter — from stadium lights to everyday ambition."
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Bento Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Campaign image"
        },
        {
          "type": "text",
          "id": "pill",
          "label": "Tagline pill",
          "default": "Energy · Adventure · Freedom"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Unleash Your Energy. Own Your Journey."
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Born to Move. Made to Inspire."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CR7 Bento Showcase"
    }
  ]
}
{% endschema %}

