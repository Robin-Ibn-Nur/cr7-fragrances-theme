{%- comment -%}
  CR7 Luxury Minimal Contact Section
  White editorial layout with concierge details, Shopify native contact form, and quiet FAQs.
{%- endcomment -%}

{{ 'cr7-contact.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cr7-contact.js' | asset_url }}" defer></script>

<section class="cr7-contact" data-section-id="{{ section.id }}">
  <div class="cr7-contact__container">
    <nav class="cr7-contact__breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ page.title | default: 'Contact' }}</span>
    </nav>

    <div class="cr7-contact__grid">
      {%- comment -%} Left: Editorial Header + Direct Channels inside same parent grid {%- endcomment -%}
      <div class="cr7-contact__left">
        <header class="cr7-contact__header">
          <div class="cr7-contact__eyebrow-row">
            <span class="cr7-contact__eyebrow">{{ section.settings.eyebrow | default: 'CONCIERGE & SUPPORT' | escape }}</span>
            <span class="cr7-contact__hairline" aria-hidden="true"></span>
          </div>
          <h1 class="cr7-contact__title">
            {{ section.settings.heading | default: 'Get in Touch' | escape }}<span class="cr7-contact__dot">.</span>
          </h1>
          {%- if section.settings.subtitle != blank -%}
            <p class="cr7-contact__subtitle">{{ section.settings.subtitle | escape }}</p>
          {%- endif -%}
        </header>

        <div class="cr7-contact__info">
          <div class="cr7-contact__info-item">
            <p class="cr7-contact__info-label">Client Concierge</p>
            <p class="cr7-contact__info-value">
              <a href="mailto:{{ section.settings.support_email | default: 'concierge@cr7fragrances.com' | escape }}">
                {{ section.settings.support_email | default: 'concierge@cr7fragrances.com' | escape }}
              </a>
            </p>
            <p class="cr7-contact__info-note">{{ section.settings.support_hours | default: 'Monday – Friday · 9:00 AM – 6:00 PM GMT' | escape }}</p>
          </div>

          <div class="cr7-contact__info-item">
            <p class="cr7-contact__info-label">Press &amp; Partnerships</p>
            <p class="cr7-contact__info-value">
              <a href="mailto:{{ section.settings.press_email | default: 'press@cr7fragrances.com' | escape }}">
                {{ section.settings.press_email | default: 'press@cr7fragrances.com' | escape }}
              </a>
            </p>
          </div>

          <div class="cr7-contact__info-item">
            <p class="cr7-contact__info-label">Response Time</p>
            <p class="cr7-contact__info-value">{{ section.settings.response_time | default: 'Within 24 business hours' | escape }}</p>
          </div>
        </div>
      </div>

      {%- comment -%} Right: Shopify Native Contact Form {%- endcomment -%}
      <div class="cr7-contact__form-card">
        {%- form 'contact', id: 'CR7-Contact-Form', class: 'cr7-contact__form' -%}
          {%- if form.posted_successfully? -%}
            <div class="cr7-contact__notice cr7-contact__notice--success" role="status">
              Thank you for reaching out. Our concierge team will respond shortly.
            </div>
          {%- elsif form.errors -%}
            <div class="cr7-contact__notice cr7-contact__notice--error" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="cr7-contact__row">
            <div class="cr7-contact__field">
              <label for="cr7-contact-name" class="cr7-contact__label">Name</label>
              <input
                id="cr7-contact-name"
                type="text"
                name="contact[name]"
                class="cr7-contact__input"
                autocomplete="name"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                placeholder="Your full name"
                required
              >
            </div>

            <div class="cr7-contact__field">
              <label for="cr7-contact-email" class="cr7-contact__label">Email</label>
              <input
                id="cr7-contact-email"
                type="email"
                name="contact[email]"
                class="cr7-contact__input"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                placeholder="you@example.com"
                required
              >
            </div>
          </div>

          <div class="cr7-contact__row">
            <div class="cr7-contact__field">
              <label for="cr7-contact-topic" class="cr7-contact__label">Topic</label>
              <select id="cr7-contact-topic" name="contact[topic]" class="cr7-contact__select">
                <option value="Order Inquiry">Order Inquiry</option>
                <option value="Fragrance Advice">Fragrance Advice</option>
                <option value="Returns & Exchanges">Returns &amp; Exchanges</option>
                <option value="Press & Partnerships">Press &amp; Partnerships</option>
                <option value="Other">Other</option>
              </select>
            </div>

            <div class="cr7-contact__field">
              <label for="cr7-contact-order" class="cr7-contact__label">Order Number (Optional)</label>
              <input
                id="cr7-contact-order"
                type="text"
                name="contact[order_number]"
                class="cr7-contact__input"
                placeholder="#CR7-1001"
              >
            </div>
          </div>

          <div class="cr7-contact__field">
            <label for="cr7-contact-body" class="cr7-contact__label">Message</label>
            <textarea
              id="cr7-contact-body"
              name="contact[body]"
              class="cr7-contact__textarea"
              placeholder="How can we assist you?"
              required
            >{% if form.body %}{{ form.body }}{% endif %}</textarea>
          </div>

          <button type="submit" class="cr7-contact__submit">
            <span>Send Message</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <line x1="4" y1="12" x2="20" y2="12"/>
              <polyline points="14 6 20 12 14 18"/>
            </svg>
          </button>
        {%- endform -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="cr7-contact__faq">
        <div>
          <h2 class="cr7-contact__faq-title">{{ section.settings.faq_heading | default: 'Frequently Asked Questions' | escape }}</h2>
        </div>

        <div class="cr7-contact__faq-list" data-cr7-faq-list>
          {%- for block in section.blocks -%}
            <div class="cr7-contact__faq-item" data-cr7-faq-item {{ block.shopify_attributes }}>
              <button
                type="button"
                class="cr7-contact__faq-btn"
                data-cr7-faq-btn
                aria-expanded="false"
                aria-controls="cr7-faq-panel-{{ block.id }}"
              >
                <span class="cr7-contact__faq-q">{{ block.settings.question | escape }}</span>
                <span class="cr7-contact__faq-plus" aria-hidden="true">+</span>
              </button>
              <div
                id="cr7-faq-panel-{{ block.id }}"
                class="cr7-contact__faq-panel"
                data-cr7-faq-panel
                aria-hidden="true"
              >
                <div class="cr7-contact__faq-panel-inner">
                  <div class="cr7-contact__faq-body">
                    {{ block.settings.answer | escape }}
                  </div>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "CR7 Contact",
  "tag": "section",
  "class": "section-cr7-contact",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "CONCIERGE & SUPPORT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get in Touch"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Whether you need assistance with an order, fragrance guidance, or press inquiries, our team is here to help."
    },
    {
      "type": "text",
      "id": "support_email",
      "label": "Support email",
      "default": "concierge@cr7fragrances.com"
    },
    {
      "type": "text",
      "id": "support_hours",
      "label": "Support hours",
      "default": "Monday – Friday · 9:00 AM – 6:00 PM GMT"
    },
    {
      "type": "text",
      "id": "press_email",
      "label": "Press email",
      "default": "press@cr7fragrances.com"
    },
    {
      "type": "text",
      "id": "response_time",
      "label": "Response time",
      "default": "Within 24 business hours"
    },
    {
      "type": "text",
      "id": "faq_heading",
      "label": "FAQ heading",
      "default": "Frequently Asked Questions"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How long does delivery take?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Standard orders are dispatched within 24–48 business hours and arrive within 2–5 business days depending on your region."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CR7 Contact"
    }
  ]
}
{% endschema %}

