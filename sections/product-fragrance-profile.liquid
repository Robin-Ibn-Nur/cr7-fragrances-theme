      "default": "#19e65a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted Text",
      "default": "#a3ada7"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "rgba(255, 255, 255, 0.12)"
    },
    {
      "type": "font_picker",
      "id": "serif_font",
      "label": "Heading Font",
      "default": "playfair_display_n5"
    },
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "OLFACTORY PYRAMID"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fragrance Notes & Profile"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "A masterfully balanced composition crafted for enduring presence."
    },
    {
      "type": "header",
      "content": "Top Notes"
    },
    {
      "type": "text",
      "id": "top_name",
      "label": "Tier Name",
      "default": "Top Notes"
    },
    {
      "type": "text",
      "id": "top_desc",
      "label": "Description",
      "default": "The first impression, lasting 15–30 minutes"
    },
    {
      "type": "text",
      "id": "default_notes_top",
      "label": "Fallback Notes (comma-separated)",
      "default": "Citrus, Bergamot, Crisp Apple"
    },
    {
      "type": "image_picker",
      "id": "top_image",
      "label": "Optional Tier Image"
    },
    {
      "type": "header",
      "content": "Heart Notes"
    },
    {
      "type": "text",
      "id": "heart_name",
      "label": "Tier Name",
      "default": "Heart Notes"
    },
    {
      "type": "text",
      "id": "heart_desc",
      "label": "Description",
      "default": "The core character, lasting 2–4 hours"
    },
    {
      "type": "text",
      "id": "default_notes_heart",
      "label": "Fallback Notes (comma-separated)",
      "default": "Lavender, Clary Sage, Cedarwood"
    },
    {
      "type": "image_picker",
      "id": "heart_image",
      "label": "Optional Tier Image"
    },
    {
      "type": "header",
      "content": "Base Notes"
    },
    {
      "type": "text",
      "id": "base_name",
      "label": "Tier Name",
      "default": "Base Notes"
    },
    {
      "type": "text",
      "id": "base_desc",
      "label": "Description",
      "default": "The lasting impression, 6+ hours"
    },
    {
      "type": "text",
      "id": "default_notes_base",
