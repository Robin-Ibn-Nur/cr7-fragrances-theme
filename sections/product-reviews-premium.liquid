{%- comment -%}
  Product Reviews Premium Section
  Target ID: pp-reviews
  Summary row (rating score, stars, verified count, recommendation %) + App blocks container ({% content_for 'blocks' %}).
  Quiet empty state with accessible modal when no review app is installed.
{%- endcomment -%}

{%- liquid
  assign rating_obj = product.metafields.reviews.rating.value | default: product.metafields.reviews.rating
  assign rating_val = 0
  if rating_obj.rating != blank
    assign rating_val = rating_obj.rating | plus: 0
  elsif rating_obj != blank
    assign rating_val = rating_obj | plus: 0
  endif
  if rating_val == 0 and section.settings.fallback_rating > 0
    assign rating_val = section.settings.fallback_rating
  endif

  assign rating_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count | default: 0 | plus: 0
  if rating_count == 0 and section.settings.fallback_count > 0
    assign rating_count = section.settings.fallback_count
  endif

  assign rec_pct = section.settings.recommend_percent
  assign app_blocks = section.blocks | where: 'type', '@app'
-%}

<section
  id="pp-reviews"
  class="prev-block"
  data-section-id="{{ section.id }}"
  data-section-type="product-reviews-premium"
  style="
    --prev-bg: {{ section.settings.background_color }};
    --prev-accent: {{ section.settings.accent_color }};
    --prev-text: {{ section.settings.text_color }};
    --prev-muted: {{ section.settings.muted_color }};
    --prev-border: {{ section.settings.border_color }};
    --prev-star: {{ section.settings.star_color }};
  "
>
  <div class="prev-block__container">
    <div class="prev-block__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="prev-block__title">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if rating_val > 0 -%}
        <div class="prev-block__summary">
          <div class="prev-block__score-group">
            <span class="prev-block__score">{{ rating_val | round: 1 }}</span>
            <div class="prev-block__stars-wrap">
              {% render 'product-rating-stars',
                rating: rating_val,
                rating_count: rating_count,
                star_size: '18px',
                star_color: section.settings.star_color,
                empty_star_color: 'rgba(255, 255, 255, 0.2)',
                show_text: false
              %}
              <span class="prev-block__count">Based on {{ rating_count }} verified reviews</span>
            </div>
          </div>

          {%- if rec_pct > 0 -%}
            <div class="prev-block__recommend">
              <span class="prev-block__recommend-badge">{{ rec_pct }}%</span>
              <span class="prev-block__recommend-text">would recommend this fragrance</span>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} App Blocks Container (Judge.me, Loox, Okendo, Yotpo, Shopify Reviews) {%- endcomment -%}
    <div class="prev-block__apps">
      {% content_for 'blocks' %}
    </div>

    {%- comment -%} Quiet fallback if no reviews app block exists {%- endcomment -%}
    {%- if app_blocks.size == 0 -%}
      <div class="prev-block__empty-state">
        <p class="prev-block__empty-msg">Have you experienced this fragrance?</p>
        <button
          type="button"
          class="prev-block__write-btn"
          onclick="document.getElementById('mpp-review-modal')?.showModal()"
        >
          Write a Review
        </button>
      </div>

      {%- comment -%} Accessible Review Modal (<dialog>) {%- endcomment -%}
      <dialog id="mpp-review-modal" class="prev-modal" aria-label="Write a Review">
        <div class="prev-modal__inner">
          <div class="prev-modal__header">
            <h3 class="prev-modal__title">Write a Review for {{ product.title }}</h3>
            <button
              type="button"
              class="prev-modal__close"
              onclick="document.getElementById('mpp-review-modal')?.close()"
              aria-label="Close dialog"
            >
              ✕
            </button>
          </div>
          <p class="prev-modal__desc">Customer reviews are powered by verified customer purchases. Please contact our support team or use your order confirmation email to submit your verified review.</p>
          <button
            type="button"
            class="prev-modal__btn-ok"
            onclick="document.getElementById('mpp-review-modal')?.close()"
          >
            Got it
          </button>
        </div>
      </dialog>
    {%- endif -%}
  </div>
</section>

{% style %}
  .prev-block {
    background-color: var(--prev-bg, #030504);
    color: var(--prev-text, #ffffff);
    padding-block: clamp(48px, 5.5vw, 84px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    position: relative;
    overflow: clip;
  }
  .prev-block__container {
    width: 100%;
    max-width: var(--page-width, calc(var(--normal-page-width, 120rem) + (var(--page-margin, 40px) * 2)));
    margin-inline: auto;
    padding-inline: var(--page-margin, 40px);
    box-sizing: border-box;
  }
  .prev-block__header {
    text-align: center;
    margin-bottom: clamp(32px, 4vw, 48px);
  }
  .prev-block__title {
    font-family: var(--font-body--family, inherit);
    font-size: clamp(16px, 1.4vw, 18px);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #ffffff;
    margin: 0 0 20px 0;
  }
  .prev-block__summary {
    display: inline-flex;
    align-items: center;
    gap: clamp(20px, 3vw, 40px);
    padding: 18px 32px;
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--prev-border, rgba(255, 255, 255, 0.12));
    flex-wrap: wrap;
    justify-content: center;
  }
  .prev-block__score-group {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .prev-block__score {
    font-size: clamp(36px, 3.8vw, 48px);
    font-weight: 700;
    color: #ffffff;
    line-height: 1;
  }
  .prev-block__stars-wrap {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }
  .prev-block__count {
    font-size: 12px;
    color: var(--prev-muted, #a3ada7);
    line-height: 1.2;
  }
  .prev-block__recommend {
    display: flex;
    align-items: center;
    gap: 10px;
    border-left: 1px solid rgba(255, 255, 255, 0.12);
    padding-left: clamp(16px, 2.5vw, 32px);
  }
  .prev-block__recommend-badge {
    font-size: 18px;
    font-weight: 700;
    color: var(--prev-accent, #19e65a);
  }
  .prev-block__recommend-text {
    font-size: 12px;
    color: var(--prev-muted, #a3ada7);
    max-width: 14ch;
    line-height: 1.3;
    text-align: left;
  }
  .prev-block__apps {
    width: 100%;
  }
  .prev-block__empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin-top: 24px;
    text-align: center;
  }
  .prev-block__empty-msg {
    font-size: 14px;
    color: var(--prev-muted, #a3ada7);
    margin: 0;
  }
  .prev-block__write-btn {
    padding: 10px 24px;
    border-radius: 9999px;
    border: 1px solid var(--prev-border, rgba(255, 255, 255, 0.2));
    background: transparent;
    color: #ffffff;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .prev-block__write-btn:hover {
    border-color: var(--prev-accent, #19e65a);
    color: var(--prev-accent, #19e65a);
    background-color: rgba(25, 230, 90, 0.06);
  }

  /* Modal */
  .prev-modal {
    padding: 0;
    border: none;
    border-radius: 8px;
    background: transparent;
    max-width: 480px;
    margin: auto;
  }
  .prev-modal::backdrop {
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(6px);
  }
  .prev-modal__inner {
    background: #0d120f;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 8px;
    padding: 24px;
    color: #ffffff;
  }
  .prev-modal__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }
  .prev-modal__title {
    font-size: 16px;
    font-weight: 600;
    margin: 0;
  }
  .prev-modal__close {
    background: transparent;
    border: none;
    color: #ffffff;
    font-size: 18px;
    cursor: pointer;
  }
  .prev-modal__desc {
    font-size: 13.5px;
    line-height: 1.6;
    color: #a3ada7;
    margin: 0 0 20px 0;
  }
  .prev-modal__btn-ok {
    padding: 10px 20px;
    border-radius: 9999px;
    border: none;
    background-color: var(--prev-accent, #19e65a);
    color: #04140a;
    font-weight: 700;
    cursor: pointer;
    font-size: 12px;
  }

  @media screen and (max-width: 749px) {
    .prev-block__container {
      padding-inline: var(--page-margin, 16px);
    }
    .prev-block__summary {
      flex-direction: column;
      gap: 16px;
      padding: 16px 20px;
    }
    .prev-block__recommend {
      border-left: none;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      padding-left: 0;
      padding-top: 14px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Product Reviews (Premium)",
  "tag": "section",
  "class": "section-product-reviews-premium",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#030504"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#19e65a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted Text",
      "default": "#a3ada7"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "rgba(255, 255, 255, 0.12)"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star Color",
      "default": "#f2b01e"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CUSTOMER REVIEWS"
    },
    {
      "type": "range",
      "id": "fallback_rating",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "label": "Default Rating (if metafield blank)",
      "default": 4.8
    },
    {
      "type": "number",
      "id": "fallback_count",
      "label": "Default Review Count (if metafield blank)",
      "default": 248
    },
    {
      "type": "range",
      "id": "recommend_percent",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Recommendation Percentage",
      "default": 94
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Product Reviews (Premium)"
    }
  ]
}
{% endschema %}
