{%- comment -%}
  Sticky Tabs Bar for Product Detail Page
{%- endcomment -%}

{{ 'product-tabs-nav.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-tabs-nav.js' | asset_url }}" type="module" defer></script>

{%- liquid
  assign rating_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count | default: 0 | plus: 0
-%}

<div
  id="ProductTabsNav-{{ section.id }}"
  class="ptn-bar"
  data-section-id="{{ section.id }}"
  data-section-type="product-tabs-nav"
  style="
    --ptn-bg: {{ section.settings.background_color }};
    --ptn-accent: {{ section.settings.accent_color }};
    --ptn-text: {{ section.settings.text_color }};
    --ptn-muted: {{ section.settings.muted_color }};
    --ptn-border: {{ section.settings.border_color }};
  "
>
  <div class="ptn-bar__container">
    <nav aria-label="Product sections">
      <ul class="ptn-nav">
        {%- for block in section.blocks -%}
          {%- liquid
            assign raw_label = block.settings.label
            if rating_count > 0
              assign label_text = raw_label | replace: '{count}', rating_count
            else
              assign label_text = raw_label | replace: '({count})', '' | replace: '{count}', '' | strip
            endif
          -%}
          <li class="ptn-nav__item" {{ block.shopify_attributes }}>
            <a
              href="#{{ block.settings.target_id }}"
              class="ptn-nav__link"
              {% if forloop.first %}aria-current="true"{% endif %}
            >
              {{ label_text }}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>
  </div>
</div>

{% schema %}
{
  "name": "Product Tabs Bar",
  "tag": "section",
  "class": "section-product-tabs-nav",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "rgba(3, 5, 4, 0.96)"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#19e65a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Active Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Tab Text Color",
      "default": "#a3ada7"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "rgba(255, 255, 255, 0.1)"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tab Label",
          "default": "Description",
          "info": "Use {count} for review count"
        },
        {
          "type": "text",
          "id": "target_id",
          "label": "Target Section ID",
          "default": "pp-description",
          "info": "Must match the id of the target section (e.g. pp-description, pp-notes, pp-shipping, pp-reviews)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Tabs Bar",
      "blocks": [
        {
          "type": "tab",
          "settings": {
            "label": "DESCRIPTION",
            "target_id": "pp-description"
          }
        },
        {
          "type": "tab",
          "settings": {
            "label": "FRAGRANCE NOTES",
            "target_id": "pp-notes"
          }
        },
        {
          "type": "tab",
          "settings": {
            "label": "SHIPPING & RETURNS",
            "target_id": "pp-shipping"
          }
        },
        {
          "type": "tab",
          "settings": {
            "label": "REVIEWS ({count})",
            "target_id": "pp-reviews"
          }
        }
      ]
    }
  ]
}
{% endschema %}
