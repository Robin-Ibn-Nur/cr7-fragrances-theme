{%- comment -%}
  CR7 Floating Ambient Audio Player (Bottom-Left)
  Beating/blinking luxury play button with animated emerald equalizer bars.
{%- endcomment -%}

<div class="cr7-audio-wrap">
  <audio
    id="cr7-ambient-audio"
    src="{{ 'cr7-ambient-audio.m4a' | asset_url }}"
    loop
    preload="none"
  ></audio>

  <button
    type="button"
    id="cr7-audio-btn"
    class="cr7-audio-btn"
    aria-label="Play background soundtrack"
    aria-pressed="false"
  >
    <span class="cr7-audio-btn__pulse" aria-hidden="true"></span>
    <span class="cr7-audio-btn__pulse cr7-audio-btn__pulse--delay" aria-hidden="true"></span>

    <span class="cr7-audio-btn__icon cr7-audio-btn__icon--play" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="currentColor">
        <polygon points="8 5 19 12 8 19 8 5"></polygon>
      </svg>
    </span>

    <span class="cr7-audio-btn__eq" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
      <span></span>
    </span>

    <span class="cr7-audio-btn__dot" aria-hidden="true"></span>
  </button>
</div>

<style>
  .cr7-audio-wrap {
    position: fixed;
    left: clamp(16px, 3vw, 28px);
    bottom: clamp(16px, 3vw, 28px);
    z-index: 9990;
  }

  .cr7-audio-btn {
    position: relative;
    width: 50px;
    height: 50px;
    padding: 0;
    border: 1.5px solid rgba(0, 200, 83, 0.72);
    border-radius: 50%;
    background: linear-gradient(145deg, #141414, #070707);
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.28),
                0 0 18px rgba(0, 200, 83, 0.22);
    animation: cr7AudioHeartbeat 1.8s cubic-bezier(0.25, 1, 0.5, 1) infinite;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
  }

  .cr7-audio-btn:hover,
  .cr7-audio-btn:focus-visible {
    transform: scale(1.07);
    border-color: #00e676;
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.36),
                0 0 24px rgba(0, 200, 83, 0.45);
  }

  .cr7-audio-btn:focus-visible {
    outline: 2px solid #00c853;
    outline-offset: 4px;
  }

  /* Concentric blinking/beating sonar rings */
  .cr7-audio-btn__pulse {
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 1.5px solid rgba(0, 200, 83, 0.7);
    pointer-events: none;
    animation: cr7AudioRing 2.1s cubic-bezier(0.165, 0.84, 0.44, 1) infinite;
  }

  .cr7-audio-btn__pulse--delay {
    animation-delay: 1.05s;
  }

  /* Live blinking status dot */
  .cr7-audio-btn__dot {
    position: absolute;
    top: 2px;
    right: 2px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background-color: #00e676;
    border: 1.5px solid #0a0a0a;
    animation: cr7AudioBlink 1.1s ease-in-out infinite;
  }

  /* Play triangle */
  .cr7-audio-btn__icon--play {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-left: 2px;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .cr7-audio-btn__icon--play svg {
    width: 18px;
    height: 18px;
  }

  /* Equalizer bars (visible while playing) */
  .cr7-audio-btn__eq {
    display: none;
    align-items: flex-end;
    justify-content: center;
    gap: 3px;
    height: 18px;
  }

  .cr7-audio-btn__eq span {
    width: 3px;
    height: 6px;
    border-radius: 2px;
    background-color: #00e676;
    animation: cr7AudioEq 0.75s ease-in-out infinite alternate;
  }

  .cr7-audio-btn__eq span:nth-child(2) {
    animation-delay: 0.18s;
  }

  .cr7-audio-btn__eq span:nth-child(3) {
    animation-delay: 0.36s;
  }

  .cr7-audio-btn__eq span:nth-child(4) {
    animation-delay: 0.12s;
  }

  /* Playing state */
  .cr7-audio-btn.is-playing {
    background: linear-gradient(145deg, #008a38, #005c25);
    border-color: #00e676;
    animation: cr7AudioHeartbeat 1.1s cubic-bezier(0.25, 1, 0.5, 1) infinite;
  }

  .cr7-audio-btn.is-playing .cr7-audio-btn__icon--play {
    display: none;
  }

  .cr7-audio-btn.is-playing .cr7-audio-btn__eq {
    display: inline-flex;
  }

  .cr7-audio-btn.is-playing .cr7-audio-btn__eq span {
    background-color: #ffffff;
  }

  @keyframes cr7AudioHeartbeat {
    0%, 100% {
      transform: scale(1);
    }
    18% {
      transform: scale(1.06);
    }
    36% {
      transform: scale(1);
    }
    54% {
      transform: scale(1.03);
    }
  }

  @keyframes cr7AudioRing {
    0% {
      transform: scale(1);
      opacity: 0.85;
    }
    100% {
      transform: scale(1.62);
      opacity: 0;
    }
  }

  @keyframes cr7AudioBlink {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.3;
      transform: scale(0.8);
    }
  }

  @keyframes cr7AudioEq {
    0% {
      height: 5px;
    }
    100% {
      height: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cr7-audio-btn,
    .cr7-audio-btn__pulse,
    .cr7-audio-btn__dot,
    .cr7-audio-btn__eq span {
      animation: none !important;
    }
  }
</style>

<script>
  (function () {
    var audio = document.getElementById('cr7-ambient-audio');
    var btn = document.getElementById('cr7-audio-btn');
    if (!audio || !btn || btn.__cr7AudioBound) return;
    btn.__cr7AudioBound = true;

    var KEY_PLAYING = 'cr7_audio_playing';
    var KEY_TIME = 'cr7_audio_time';

    audio.volume = 0.55;

    function setPlayingState(playing) {
      btn.classList.toggle('is-playing', playing);
      btn.setAttribute('aria-pressed', String(playing));
      btn.setAttribute('aria-label', playing ? 'Pause background soundtrack' : 'Play background soundtrack');
    }

    function saveState() {
      try {
        sessionStorage.setItem(KEY_PLAYING, audio.paused ? '0' : '1');
        if (!isNaN(audio.currentTime) && audio.currentTime > 0) {
          sessionStorage.setItem(KEY_TIME, String(audio.currentTime));
        }
      } catch (e) {}
    }

    function resumeFromSavedTime() {
      var savedTime = 0;
      try {
        savedTime = parseFloat(sessionStorage.getItem(KEY_TIME) || '0') || 0;
      } catch (e) {}

      function seekAndPlay() {
        if (savedTime > 0 && isFinite(audio.duration) && savedTime < audio.duration) {
          try {
            audio.currentTime = savedTime;
          } catch (e) {}
        } else if (savedTime > 0 && !isFinite(audio.duration)) {
          try {
            audio.currentTime = savedTime;
          } catch (e) {}
        }

        var p = audio.play();
        if (p && typeof p.then === 'function') {
          p.then(function () {
            setPlayingState(true);
          }).catch(function () {
            // Browser blocked autoplay on navigation; resume on first interaction
            setPlayingState(false);
            var onFirstGesture = function () {
              if (sessionStorage.getItem(KEY_PLAYING) !== '1') return;
              var t = parseFloat(sessionStorage.getItem(KEY_TIME) || '0') || 0;
              if (t > 0) {
                try { audio.currentTime = t; } catch (e) {}
              }
              audio.play().then(function () {
                setPlayingState(true);
              }).catch(function () {});
            };
            document.addEventListener('pointerdown', onFirstGesture, { once: true, capture: true });
            document.addEventListener('keydown', onFirstGesture, { once: true, capture: true });
          });
        } else {
          setPlayingState(true);
        }
      }

      if (audio.readyState >= 1) {
        seekAndPlay();
      } else {
        audio.preload = 'auto';
        audio.addEventListener('loadedmetadata', seekAndPlay, { once: true });
        audio.load();
      }
    }

    // Auto-resume if user had audio playing before navigating
    try {
      if (sessionStorage.getItem(KEY_PLAYING) === '1') {
        resumeFromSavedTime();
      }
    } catch (e) {}

    btn.addEventListener('click', function () {
      if (audio.paused) {
        audio.preload = 'auto';
        var playPromise = audio.play();
        if (playPromise && typeof playPromise.then === 'function') {
          playPromise.then(function () {
            setPlayingState(true);
            saveState();
          }).catch(function (err) {
            console.warn('[cr7-audio] Playback failed:', err);
          });
        } else {
          setPlayingState(true);
          saveState();
        }
      } else {
        audio.pause();
        setPlayingState(false);
        try {
          sessionStorage.setItem(KEY_PLAYING, '0');
          sessionStorage.setItem(KEY_TIME, String(audio.currentTime || 0));
        } catch (e) {}
      }
    });

    audio.addEventListener('timeupdate', function () {
      if (!audio.paused) {
        try {
          sessionStorage.setItem(KEY_TIME, String(audio.currentTime || 0));
        } catch (e) {}
      }
    });

    window.addEventListener('pagehide', saveState);
    window.addEventListener('beforeunload', saveState);

    audio.addEventListener('ended', function () {
      setPlayingState(false);
    });

    // Zero-interruption soft navigation while background audio is playing
    var navController = null;

    function isSoftNavEligible(link) {
      if (!link) return false;
      var rawHref = link.getAttribute('href');
      if (!rawHref || rawHref.charAt(0) === '#') return false;
      if (link.target && link.target !== '_self') return false;
      if (link.hasAttribute('download')) return false;

      var url;
      try {
        url = new URL(link.href, window.location.href);
      } catch (e) {
        return false;
      }
      if (url.origin !== window.location.origin) return false;
      if (url.pathname === window.location.pathname && url.search === window.location.search && url.hash) return false;

      // Keep checkout, account, cart, and admin on native full navigation
      if (/^\/(admin|cart|checkout|account|challenge)/.test(url.pathname)) return false;
      return true;
    }

    function syncHeadStyles(newDoc) {
      var existingHrefs = new Set(
        Array.from(document.head.querySelectorAll('link[rel="stylesheet"]')).map(function (l) {
          return l.getAttribute('href');
        })
      );
      var stylePromises = [];

      newDoc.head.querySelectorAll('link[rel="stylesheet"]').forEach(function (link) {
        var href = link.getAttribute('href');
        if (href && !existingHrefs.has(href)) {
          var clone = document.createElement('link');
          clone.rel = 'stylesheet';
          clone.href = href;
          stylePromises.push(new Promise(function (resolve) {
            clone.onload = resolve;
            clone.onerror = resolve;
            window.setTimeout(resolve, 1500);
          }));
          document.head.appendChild(clone);
        }
      });

      // Sync Shopify subsetted <style> blocks from the target page <head>
      var existingStyleTexts = new Set(
        Array.from(document.head.querySelectorAll('style')).map(function (s) {
          return s.textContent.trim();
        })
      );
      newDoc.head.querySelectorAll('style').forEach(function (styleEl) {
        var text = styleEl.textContent.trim();
        if (text && !existingStyleTexts.has(text)) {
          var cloneStyle = document.createElement('style');
          if (styleEl.hasAttribute('data-shopify')) cloneStyle.setAttribute('data-shopify', '');
          cloneStyle.textContent = styleEl.textContent;
          document.head.appendChild(cloneStyle);
          existingStyleTexts.add(text);
        }
      });

      return Promise.all(stylePromises);
    }

    async function softNavigate(url, pushHistory) {
      if (navController) navController.abort();
      navController = new AbortController();

      document.documentElement.classList.add('cr7-soft-nav-loading');

      try {
        var res = await fetch(url, {
          credentials: 'same-origin',
          signal: navController.signal
        });
        if (!res.ok) throw new Error('HTTP ' + res.status);
        var contentType = res.headers.get('content-type') || '';
        if (!contentType.includes('text/html')) throw new Error('Non-HTML');

        var html = await res.text();
        var parser = new DOMParser();
        var newDoc = parser.parseFromString(html, 'text/html');
        var newMain = newDoc.getElementById('MainContent');
        var curMain = document.getElementById('MainContent');
        if (!newMain || !curMain) throw new Error('Missing MainContent');

        // Close fullscreen menu if open
        var fsMenu = document.getElementById('cr7-fs-menu');
        if (fsMenu && fsMenu.classList.contains('is-open')) {
          fsMenu.classList.remove('is-open');
          fsMenu.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        }

        await syncHeadStyles(newDoc);

        // Sync transparent header attribute if changed
        var curHeader = document.getElementById('header-component');
        var newHeader = newDoc.getElementById('header-component');
        if (curHeader && newHeader) {
          if (newHeader.hasAttribute('transparent')) {
            curHeader.setAttribute('transparent', newHeader.getAttribute('transparent') || '');
          } else {
            curHeader.removeAttribute('transparent');
          }
        }

        document.title = newDoc.title || document.title;
        curMain.setAttribute('data-template', newMain.getAttribute('data-template') || '');
        curMain.innerHTML = newMain.innerHTML;

        // Execute only executable JS scripts inside swapped MainContent (skip application/json, ld+json, etc.)
        var loadedSrcs = new Set(
          Array.from(document.querySelectorAll('script[src]')).map(function (s) { return s.getAttribute('src'); })
        );
        var scriptPromises = [];
        curMain.querySelectorAll('script').forEach(function (oldScript) {
          var type = (oldScript.getAttribute('type') || '').trim().toLowerCase();
          if (type && type !== 'text/javascript' && type !== 'application/javascript' && type !== 'module') {
            return;
          }
          var src = oldScript.getAttribute('src');
          if (src && loadedSrcs.has(src)) return;

          var s = document.createElement('script');
          if (type) s.type = type;
          if (src) {
            s.src = src;
            loadedSrcs.add(src);
            scriptPromises.push(new Promise(function (resolve) {
              s.onload = resolve;
              s.onerror = resolve;
              window.setTimeout(resolve, 1500);
            }));
          } else {
            s.textContent = oldScript.textContent;
          }
          oldScript.replaceWith(s);
        });

        if (pushHistory) {
          window.history.pushState({ cr7SoftNav: true }, '', url);
        }

        window.scrollTo(0, 0);
        if (scriptPromises.length) {
          await Promise.all(scriptPromises);
        }
        document.dispatchEvent(new CustomEvent('shopify:section:load', { detail: { softNav: true } }));
      } catch (err) {
        if (err && err.name === 'AbortError') return;
        saveState();
        window.location.href = url;
      } finally {
        document.documentElement.classList.remove('cr7-soft-nav-loading');
      }
    }

    document.addEventListener('click', function (e) {
      if (audio.paused) return;
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      var link = e.target.closest('a');
      if (!isSoftNavEligible(link)) return;
      e.preventDefault();
      e.stopPropagation();
      softNavigate(link.href, true);
    }, true);

    window.addEventListener('popstate', function () {
      if (audio.paused) return;
      softNavigate(window.location.href, false);
    });
  })();
</script>

