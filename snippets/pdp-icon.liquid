{%- doc -%}
  PDP SVG Icon Snippet
  @param {string} icon - Name of the icon
  @param {string} [class] - Optional class
  @param {string} [style] - Optional inline style
{%- enddoc -%}

{%- case icon -%}
  {%- when 'arrow-left' or 'chevron-left' -%}
    <svg class="{{ class }}" style="{{ style }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="15 18 9 12 15 6"/>
    </svg>

  {%- when 'arrow-right' or 'chevron-right' -%}
    <svg class="{{ class }}" style="{{ style }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="9 18 15 12 9 6"/>
    </svg>

  {%- when 'heart' -%}
    <svg class="{{ class }}" style="{{ style }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
