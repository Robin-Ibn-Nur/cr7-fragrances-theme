{%- doc -%}
  Product Card Custom (Spec Card)
  Renders the universal product card with badge, 9:5 ratio image, category,
  title, description, feature chips, price, add to cart button with shine,
  and meta row (stars + stock).

  @param {object} product - The Shopify product object
  @param {string} [image_loading='lazy'] - Image loading attribute ('lazy' or 'eager')
  @param {string} [sizes] - Custom sizes attribute for responsive image
  @param {boolean} [show_add_to_cart=true] - Whether to show the add to cart button
  @param {string} [badge_label] - Custom override for the hot sale badge
  @param {string} [class] - Optional extra class names for the card
{%- enddoc -%}

{%- if product != blank and product.id != blank -%}
  {{ 'product-card-custom.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-card-custom.js' | asset_url }}" type="module" defer></script>

  {%- liquid
    assign image_loading = image_loading | default: 'lazy'
    if show_add_to_cart == nil
      assign show_add_to_cart = true
    endif

    assign current_variant = product.selected_or_first_available_variant
    assign is_available = product.available
    assign primary_image = product.featured_media.preview_image | default: product.featured_image

    # Multi-variant / selling plan / gift card check
    assign needs_options = false
    if product.variants.size > 1 or product.selling_plan_groups.size > 0 or product.gift_card?
      assign needs_options = true
    endif

    # Pricing & Sale check
    assign is_on_sale = false
    if current_variant.compare_at_price > current_variant.price
      assign is_on_sale = true
    endif

    # Category line: product.type fallback vendor
    assign category_label = product.type
    if category_label == blank
      assign category_label = product.vendor
    endif

    # Description: stripped and truncated, clamped to 2 lines
    assign clean_desc = product.description | strip_html | strip_newlines | truncatewords: 25

    # Feature chips: product metafield custom.card_features (list of single line text)
    assign feature_chips = product.metafields.custom.card_features.value
    assign has_chips = false
    if feature_chips != blank and feature_chips.size > 0
      assign has_chips = true
    endif

    # Rating metadata (real data only, never fake)
    assign rating_metafield = product.metafields.reviews.rating.value | default: product.metafields.reviews.rating
    assign rating_value = null
    if rating_metafield.rating != blank
      assign rating_value = rating_metafield.rating | round: 1
    elsif rating_metafield != blank
      assign rating_value = rating_metafield | round: 1
    endif

    assign rating_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count
    assign has_rating = false
    if rating_value != blank and rating_count != blank and rating_count > 0
      assign has_rating = true
      assign rating_percent = rating_value | times: 100.0 | divided_by: 5.0 | round
    endif

    # Stock status
    assign show_stock = false
    assign stock_text = ''
    assign stock_class = ''
    if is_available
      assign show_stock = true
      assign stock_text = 'In stock'
      assign stock_class = 'pcc-stock--in'

      if product.variants.size == 1
        assign single_var = product.variants.first
        if single_var.inventory_management != blank and single_var.inventory_quantity > 0 and single_var.inventory_quantity <= 5
          assign stock_text = 'Only ' | append: single_var.inventory_quantity | append: ' left'
          assign stock_class = 'pcc-stock--low'
        endif
      endif
    else
      assign show_stock = true
      assign stock_text = 'Out of stock'
      assign stock_class = 'pcc-stock--out'
    endif

    assign form_id = 'PccForm-' | append: product.id | append: '-' | append: forloop.index0
    assign img_sizes = sizes | default: '(min-width: 1200px) 400px, (min-width: 750px) 50vw, 100vw'
  -%}

  <div
    class="pcc-card{% if class != blank %} {{ class }}{% endif %}{% unless is_available %} is-sold-out{% endunless %}"
    data-product-id="{{ product.id }}"
    data-product-handle="{{ product.handle }}"
    style="--pcc-btn-bg: #000000; --pcc-btn-color: #ffffff;"
  >
    <!-- Badge: Hot Sale or Sold Out (Never both, top-right) -->
    {%- if is_available == false -%}
      <div class="pcc-badge pcc-badge--sold-out">Sold out</div>
    {%- elsif is_on_sale -%}
      <div class="pcc-badge pcc-badge--sale">
        {{ badge_label | default: 'HOT SALE' }}
      </div>
    {%- endif -%}

    <!-- Image Area: 9:5 ratio, overflow hidden -->
    <div class="pcc-image-wrap">
      {%- if primary_image != blank -%}
        {{
          primary_image
          | image_url: width: 1080
          | image_tag:
            loading: image_loading,
            widths: '360, 540, 720, 900, 1080',
            sizes: img_sizes,
            alt: '',
            class: 'pcc-image'
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'pcc-image pcc-placeholder' }}
      {%- endif -%}
    </div>

    <!-- Info Block -->
    <div class="pcc-info">
      <!-- Category Label -->
      {%- if category_label != blank -%}
        <div class="pcc-category">{{ category_label | escape }}</div>
      {%- endif -%}

      <!-- Title (with stretched link covering the card) -->
      <h3 class="pcc-title">
        <a href="{{ product.url }}" class="pcc-title-link">
          {{ product.title | escape }}
        </a>
      </h3>

      <!-- Description: clamped to 2 lines -->
      {%- if clean_desc != blank -%}
        <p class="pcc-description">{{ clean_desc }}</p>
      {%- endif -%}

      <!-- Feature Chips: from metafield custom.card_features (max 3) -->
      {%- if has_chips -%}
        <div class="pcc-chips">
          {%- for chip in feature_chips limit: 3 -%}
            {%- if chip != blank -%}
              <span class="pcc-chip">{{ chip | escape }}</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <!-- Bottom Row: Price column on left, Add-to-cart on right -->
      <div class="pcc-bottom-row">
        <div class="pcc-price-col">
          {%- if is_on_sale -%}
            <span class="pcc-price-compare">
              {{ current_variant.compare_at_price | money }}
            </span>
          {%- endif -%}
          <div class="pcc-price-current-wrap">
            {%- if product.price_varies -%}
              <span class="pcc-price-from">From </span>
            {%- endif -%}
            <span class="pcc-price-current">
              {{ current_variant.price | money }}
            </span>
          </div>
        </div>

        {%- if show_add_to_cart -%}
          <div class="pcc-btn-col">
            {%- if is_available == false -%}
              <button
                type="button"
                class="pcc-btn is-sold-out"
                disabled
                aria-disabled="true"
              >
                <span class="pcc-btn-text">Sold out</span>
              </button>
            {%- elsif needs_options -%}
              <a
                href="{{ product.url }}"
                class="pcc-btn pcc-btn--options"
                aria-label="Choose options for {{ product.title | escape }}"
              >
                <span class="pcc-btn-text">Choose options</span>
                <svg class="pcc-btn-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                  <line x1="3" y1="6" x2="21" y2="6"></line>
                  <path d="M16 10a4 4 0 0 1-8 0"></path>
                </svg>
              </a>
            {%- else -%}
              {%- form 'product', product, id: form_id, class: 'pcc-form', data-product-id: product.id -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}">
                <input type="hidden" name="quantity" value="1">
                <button
                  type="submit"
                  name="add"
                  class="pcc-btn"
                  data-pcc-btn
                  aria-label="Add {{ product.title | escape }} to cart"
                >
                  <span class="pcc-btn-text" data-pcc-btn-text>Add to cart</span>
                  <svg class="pcc-btn-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <path d="M16 10a4 4 0 0 1-8 0"></path>
                  </svg>
                </button>
              {%- endform -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Meta Row: Top border, Rating on left, Stock status on right -->
      {%- if has_rating or show_stock -%}
        <div class="pcc-meta-row">
          {%- if has_rating -%}
            <div class="pcc-rating">
              <div class="pcc-stars-wrap" aria-label="{{ rating_value }} out of 5 stars">
                <div class="pcc-stars-bg" aria-hidden="true">
                  {%- for i in (1..5) -%}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                  {%- endfor -%}
                </div>
                <div class="pcc-stars-fill" style="width: {{ rating_percent }}%;" aria-hidden="true">
                  {%- for i in (1..5) -%}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                  {%- endfor -%}
                </div>
              </div>
              <span class="pcc-rating-count">
                <span class="pcc-rating-text-full">{{ rating_count }} Reviews</span>
                <span class="pcc-rating-text-short">({{ rating_count }})</span>
              </span>
            </div>
          {%- else -%}
            <div></div>
          {%- endif -%}

          {%- if show_stock -%}
            <div class="pcc-stock {{ stock_class }}">
              {{ stock_text }}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <!-- Accessible status live region -->
    <div class="visually-hidden" aria-live="polite" data-pcc-status></div>
  </div>
{%- endif -%}
