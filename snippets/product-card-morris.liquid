{%- doc -%}
  Product Card Morris (Matched to CR7 Store)
  - Colors matched to website (clean white/black with signature red accent)
  - Zero image padding (edge-to-edge cover)
  - Random review counts per product
  - High-visibility, high-contrast left-aligned content
  - Slide-up "ADD TO CART" button with loading spinner & checkmark
  - Dual-image hover cross-fade with 1.07 zoom
  - Embedded Quick View modal

  @param {object} product - The Shopify product object
  @param {string} [image_loading='lazy'] - Image loading attribute
  @param {string} [sizes] - Custom responsive sizes
  @param {string} [class] - Optional additional CSS classes
{%- enddoc -%}

{%- if product != blank and product.id != blank -%}
  {{ 'product-card-morris.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-card-morris.js' | asset_url }}" type="module" defer></script>

  {%- liquid
    assign image_loading = image_loading | default: 'lazy'
    assign current_variant = product.selected_or_first_available_variant
    assign is_available = product.available

    # Primary and Secondary images for dual hover cross-fade
    assign primary_image = product.featured_media.preview_image | default: product.featured_image
    assign secondary_image = null
    if product.media.size > 1
      assign secondary_image = product.media[1].preview_image
    elsif product.images.size > 1
      assign secondary_image = product.images[1]
    endif

    # Multi-variant / options check
    assign needs_options = false
    if product.variants.size > 1 or product.selling_plan_groups.size > 0 or product.gift_card?
      assign needs_options = true
    endif

    # Sale check
    assign is_on_sale = false
    if current_variant.compare_at_price > current_variant.price
      assign is_on_sale = true
    endif

    # Ribbon check (Featured tag or bestseller)
    assign is_featured = false
    if product.tags contains 'featured' or product.tags contains 'Featured' or product.tags contains 'bestseller' or product.tags contains 'Bestseller'
      assign is_featured = true
    endif

    # Stable pseudo-random review count for now
    assign rand_seed = product.id | modulo: 173
    assign fake_review_count = rand_seed | plus: 38
    if fake_review_count < 28
      assign fake_review_count = 64
    endif

    assign img_sizes = sizes | default: '(min-width: 1200px) 400px, (min-width: 750px) 50vw, 100vw'
    assign quickview_id = 'MorrisQuickView-' | append: product.id | append: '-' | append: forloop.index0
  -%}

  <div
    class="lilac-product-card has-zoom has-lift{% if secondary_image != blank %} has-secondary{% endif %}{% if class != blank %} {{ class }}{% endif %}{% unless is_available %} is-sold-out{% endunless %}"
    data-product-id="{{ product.id }}"
    data-variant-id="{{ current_variant.id }}"
    data-handle="{{ product.handle }}"
    style="
      --lpc-fit: cover;
      --lpc-ratio: 4 / 5;
      --lpc-img-pad: 0px;
      --lpc-max-w: 100%;
      --lpc-radius: 0px;
      --lpc-align: left;
      --lpc-align-items: flex-start;
      --lpc-thumb-bg: #f8f8f8;
      --lpc-title-color: #111111;
      --lpc-price-color: #111111;
      --lpc-accent: #e60000;
      --lpc-btn-bg: #000000;
      --lpc-btn-text: #ffffff;
      --lpc-btn-hover-bg: #e60000;
      --lpc-btn-hover-text: #ffffff;
      --lpc-star-color: #f59e0b;
    "
  >
    <!-- Thumbnail Container (Zero Padding) -->
    <div class="lilac-product-card__thumb">
      {%- if is_featured -%}
        <!-- Ribbon Pin Badge -->
        <div class="lilac-product-card__ribbon" title="Featured">
          <svg viewBox="0 0 24 24" fill="currentColor" width="12" height="12" aria-hidden="true">
            <path d="M16 12V4h1V2H7v2h1v8l-2 2v2h5.2v6l.8.8.8-.8v-6H18v-2l-2-2z"/>
          </svg>
        </div>
      {%- endif -%}

      {%- if is_available == false -%}
        <span class="lilac-product-card__sale-badge lilac-product-card__sale-badge--sold-out{% if is_featured %} has-ribbon{% endif %}">
          Sold Out
        </span>
      {%- endif -%}

      <!-- Quick View Trigger Button (Top-Right) -->
      <button
        type="button"
        class="lilac-product-card__quickview-btn js-quickview-open"
        data-tooltip="Quick View"
        aria-label="Quick View {{ product.title | escape }}"
      >
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
          <circle cx="12" cy="12" r="3"></circle>
        </svg>
      </button>

      <!-- Image Link & Cross-Fade Container (Zero Padding) -->
      <a href="{{ product.url }}" class="lilac-product-card__image-link" aria-label="{{ product.title | escape }}">
        <div class="lilac-product-card__image-container">
          {%- if primary_image != blank -%}
            {{
              primary_image
              | image_url: width: 900
              | image_tag:
                loading: image_loading,
                widths: '360, 540, 720, 900',
                sizes: img_sizes,
                alt: product.title,
                class: 'lilac-product-card__img lilac-product-card__img--primary'
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'lilac-product-card__img lilac-product-card__img--primary' }}
          {%- endif -%}

          {%- if secondary_image != blank -%}
            {{
              secondary_image
              | image_url: width: 900
              | image_tag:
                loading: 'lazy',
                widths: '360, 540, 720, 900',
                sizes: img_sizes,
                alt: product.title,
                class: 'lilac-product-card__img lilac-product-card__img--secondary'
            }}
          {%- endif -%}
        </div>
      </a>

      <!-- Slide-Up Add to Cart Button -->
      {%- if is_available == false -%}
        <button
          type="button"
          class="lilac-product-card__add-btn is-sold-out"
          disabled
          aria-disabled="true"
        >
          <span class="lilac-product-card__add-text">SOLD OUT</span>
        </button>
      {%- elsif needs_options -%}
        <a
          href="{{ product.url }}"
          class="lilac-product-card__add-btn"
          aria-label="Choose options for {{ product.title | escape }}"
        >
          <span class="lilac-product-card__add-text">CHOOSE OPTIONS</span>
        </a>
      {%- else -%}
        <button
          type="button"
          class="lilac-product-card__add-btn js-quick-add"
          data-variant-id="{{ current_variant.id }}"
          aria-label="Add {{ product.title | escape }} to Cart"
        >
          <span class="lilac-product-card__add-text">ADD TO CART</span>
          <span class="lilac-btn-spinner" aria-hidden="true"></span>
          <span class="lilac-btn-check" aria-hidden="true" style="display:none;">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </span>
        </button>
      {%- endif -%}
    </div>

    <!-- Card Information (Left Aligned & Highly Visible) -->
    <div class="lilac-product-card__info">
      <!-- Title: Crisp & Bold -->
      <h3 class="lilac-product-card__title">
        <a href="{{ product.url }}">{{ product.title | escape }}</a>
      </h3>

      <!-- 5 Gold Stars Rating + Random Review Count -->
      <div class="lilac-product-card__rating" aria-label="5 out of 5 stars ({{ fake_review_count }} reviews)">
        <div class="lilac-stars-group" aria-hidden="true">
          <span class="lilac-star lilac-star--full">★</span>
          <span class="lilac-star lilac-star--full">★</span>
          <span class="lilac-star lilac-star--full">★</span>
          <span class="lilac-star lilac-star--full">★</span>
          <span class="lilac-star lilac-star--full">★</span>
        </div>
        <span class="lilac-product-card__review-count">({{ fake_review_count }})</span>
      </div>

      <!-- Price Wrap: Prominent & High Contrast -->
      <div class="lilac-product-card__price-wrap">
        <span class="lilac-product-card__price">
          {%- if product.price_varies -%}<span class="lilac-price-from">From </span>{%- endif -%}
          {{ current_variant.price | money }}
        </span>
        {%- if is_on_sale -%}
          <span class="lilac-product-card__price--compare">{{ current_variant.compare_at_price | money }}</span>
        {%- endif -%}
      </div>
    </div>

    <!-- Quick View Modal (Embedded with Backdrop Blur) -->
    <div class="lilac-quickview-modal js-quickview-modal" aria-hidden="true" id="{{ quickview_id }}">
      <div class="lilac-quickview-modal__overlay js-quickview-close"></div>
      <div class="lilac-quickview-modal__content">
        <button type="button" class="lilac-quickview-modal__close js-quickview-close" aria-label="Close modal">&times;</button>
        <div class="lilac-quickview-modal__grid">
          <div class="lilac-quickview-modal__media">
            {%- if primary_image != blank -%}
              <img src="{{ primary_image | image_url: width: 900 }}" alt="{{ product.title | escape }}" loading="lazy">
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <div class="lilac-quickview-modal__body">
            <span class="lilac-quickview-modal__brand">{{ product.vendor | default: shop.name | escape }}</span>
            <h2 class="lilac-quickview-modal__title">{{ product.title | escape }}</h2>
            <div class="lilac-product-card__rating" style="margin-bottom: 12px;">
              <div class="lilac-stars-group" aria-hidden="true">
                <span class="lilac-star lilac-star--full">★</span>
                <span class="lilac-star lilac-star--full">★</span>
                <span class="lilac-star lilac-star--full">★</span>
                <span class="lilac-star lilac-star--full">★</span>
                <span class="lilac-star lilac-star--full">★</span>
              </div>
              <span class="lilac-product-card__review-count">({{ fake_review_count }} Reviews)</span>
            </div>
            <div class="lilac-quickview-modal__price-wrap">
              <span class="lilac-quickview-modal__price">{{ current_variant.price | money }}</span>
              {%- if is_on_sale -%}
                <span class="lilac-product-card__price--compare" style="font-size: 16px;">{{ current_variant.compare_at_price | money }}</span>
              {%- endif -%}
            </div>
            {%- assign modal_desc = product.description | strip_html | strip_newlines | truncatewords: 30 -%}
            {%- if modal_desc != blank -%}
              <p class="lilac-quickview-modal__desc">{{ modal_desc }}</p>
            {%- endif -%}
            <div class="lilac-quickview-modal__actions">
              {%- if is_available == false -%}
                <button type="button" class="lilac-quickview-modal__btn" disabled>
                  <span>Sold Out</span>
                </button>
              {%- elsif needs_options -%}
                <a href="{{ product.url }}" class="lilac-quickview-modal__btn">
                  <span>View Options</span>
                </a>
              {%- else -%}
                <button
                  type="button"
                  class="lilac-quickview-modal__btn js-quick-add"
                  data-variant-id="{{ current_variant.id }}"
                >
                  <span>Add to Bag</span>
                </button>
              {%- endif -%}
            </div>
            <a href="{{ product.url }}" class="lilac-quickview-modal__more">View Complete Product Details &rarr;</a>
          </div>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}
